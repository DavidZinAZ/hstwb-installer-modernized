; Repair missing drawer icons at default package destinations.
; Run in Amiga Shell: Execute <path>/Repair-User-Package-Icons
; Only existing drawers are touched. Existing icons are preserved.
IF EXISTS "SYS:Prefs/Env-Archive/Sys/def_drawer.info"
  Set HstWBIconTemplate "SYS:Prefs/Env-Archive/Sys/def_drawer.info"
ELSE
  IF EXISTS "SYS:Tools.info"
    Set HstWBIconTemplate "SYS:Tools.info"
  ELSE
    Echo "No drawer icon template found. No changes made."
    Quit 20
  ENDIF
ENDIF
IF EXISTS "SYS:Tools"
  IF NOT EXISTS "SYS:Tools.info"
    Copy "$HstWBIconTemplate" "SYS:Tools.info"
    IF WARN
      Echo "Could not create SYS:Tools.info"
      Quit 20
    ENDIF
    Echo "Created SYS:Tools.info"
  ENDIF
ENDIF
