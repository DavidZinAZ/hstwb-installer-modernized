# automatically line-endings for files detected as text
* text=auto

# unix forced line-endings
/amiga/** text=auto eol=lf

# self-install host media readmes must land as CRLF on checkout (AmigaOS tooling
# convention); their LF blobs are converted by explicit rule, not by text=auto
support/self_install/amigaos/amiga-os-3.2.2/readme.txt text eol=crlf
support/self_install/amigaos/amiga-os-3.2.3/readme.txt text eol=crlf

# archives
*.lha binary
*.lzx binary
*.zip binary

# images
*.png binary
*.jpg binary
*.iff binary
