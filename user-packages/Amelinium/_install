Stack 65536
MakePath >NIL: "$INSTALLDIR"
; Give existing parent drawers icons, preserving all existing icons.
IF EXISTS "SYSTEMDIR:Tools"
  IF NOT EXISTS "SYSTEMDIR:Tools.info"
    IF EXISTS "SYSTEMDIR:Prefs/Env-Archive/Sys/def_drawer.info"
      MakeIcon >NIL: "SYSTEMDIR:Tools" FROM "SYSTEMDIR:Prefs/Env-Archive/Sys/def_drawer.info"
    ELSE
      MakeIcon >NIL: "SYSTEMDIR:Tools"
    ENDIF
  ENDIF
ENDIF
IF EXISTS "SYSTEMDIR:Tools/Network"
  IF NOT EXISTS "SYSTEMDIR:Tools/Network.info"
    IF EXISTS "SYSTEMDIR:Prefs/Env-Archive/Sys/def_drawer.info"
      MakeIcon >NIL: "SYSTEMDIR:Tools/Network" FROM "SYSTEMDIR:Prefs/Env-Archive/Sys/def_drawer.info"
    ELSE
      MakeIcon >NIL: "SYSTEMDIR:Tools/Network"
    ENDIF
  ENDIF
ENDIF
IF EXISTS "$INSTALLDIR"
  IF NOT EXISTS "$INSTALLDIR.info"
    IF EXISTS "SYSTEMDIR:Prefs/Env-Archive/Sys/def_drawer.info"
      MakeIcon >NIL: "$INSTALLDIR" FROM "SYSTEMDIR:Prefs/Env-Archive/Sys/def_drawer.info"
    ELSE
      MakeIcon >NIL: "$INSTALLDIR"
    ENDIF
  ENDIF
ENDIF
echo "Extracting Amelinium..."
IF EXISTS "$INSTALLDIR/Upstream-README.txt"
  echo "Existing Amelinium drawer retained; no files overwritten."
ELSE
  MakePath >NIL: "SYSTEMDIR:Temp/_HstWB-amelinium/"
  INSTALLDIR:C/LhA -m1 x "USERPACKAGEDIR:Amelinium.lha" "SYSTEMDIR:Temp/_HstWB-amelinium/"
  IF WARN
    echo "Archive extraction failed. Installation stopped."
    Ask "Press ENTER to continue"
    Quit 20
  ENDIF
  Copy >NIL: "SYSTEMDIR:Temp/_HstWB-amelinium/#?" "$INSTALLDIR" ALL CLONE
  IF WARN
    echo "Package copy failed. Installation stopped."
    Ask "Press ENTER to continue"
    Quit 20
  ENDIF

  Copy >NIL: "USERPACKAGEDIR:LICENSE.txt" "$INSTALLDIR" CLONE
  Copy >NIL: "USERPACKAGEDIR:SOURCE.txt" "$INSTALLDIR" CLONE
  Copy >NIL: "USERPACKAGEDIR:ReadMe.txt" "$INSTALLDIR" CLONE
  Copy >NIL: "USERPACKAGEDIR:Upstream-README.txt" "$INSTALLDIR" CLONE
ENDIF
echo "Amelinium files ready in:"
echo "$INSTALLDIR"
echo "Open the Amelinium executable matching your CPU; see ReadMe.txt."
echo "HTTPS certificates are NOT verified, including mail connections."
echo "Read ReadMe.txt for requirements and Upstream-README.txt for full instructions."
Ask "Press ENTER to continue"
